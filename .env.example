@prefix : <http://www.semanticweb.org/ontologies/2026/sri-lankan-education#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/ontologies/2026/sri-lankan-education> .

<http://www.semanticweb.org/ontologies/2026/sri-lankan-education> rdf:type owl:Ontology ;
    rdfs:comment "Ontology for the Sri Lankan School Education System" .

#################################################################
#    Object Properties
#################################################################

:attendsSchool rdf:type owl:ObjectProperty ;
               rdfs:domain :Student ;
               rdfs:range :School .

:enrolledInStage rdf:type owl:ObjectProperty ;
                 rdfs:domain :Student ;
                 rdfs:range :EducationalStage .

:teachesSubject rdf:type owl:ObjectProperty ;
                rdfs:domain :Teacher ;
                rdfs:range :Subject .

:offersStage rdf:type owl:ObjectProperty ;
             rdfs:domain :School ;
             rdfs:range :EducationalStage .

:preparesForExam rdf:type owl:ObjectProperty ;
                 rdfs:domain :EducationalStage ;
                 rdfs:range :Examination .

#################################################################
#    Data Properties
#################################################################

:hasCensusNo rdf:type owl:DatatypeProperty ;
             rdfs:domain :School ;
             rdfs:range xsd:string .

:hasStudentAge rdf:type owl:DatatypeProperty ;
               rdfs:domain :Student ;
               rdfs:range xsd:integer .

:hasTeacherID rdf:type owl:DatatypeProperty ;
              rdfs:domain :Teacher ;
              rdfs:range xsd:string .

:hasSubjectCode rdf:type owl:DatatypeProperty ;
                rdfs:domain :Subject ;
                rdfs:range xsd:string .

:hasExamYear rdf:type owl:DatatypeProperty ;
             rdfs:domain :Examination ;
             rdfs:range xsd:integer .

#################################################################
#    Classes
#################################################################

:Person rdf:type owl:Class .

:Student rdf:type owl:Class ;
         rdfs:subClassOf :Person .

:Teacher rdf:type owl:Class ;
         rdfs:subClassOf :Person ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :teachesSubject ;
                           owl:minCardinality "1"^^xsd:nonNegativeInteger
                         ] .

:Principal rdf:type owl:Class ;
           rdfs:subClassOf :Person .

:School rdf:type owl:Class .

:GovernmentSchool rdf:type owl:Class ;
                  rdfs:subClassOf :School .

:NationalSchool rdf:type owl:Class ;
                rdfs:subClassOf :GovernmentSchool .

:ProvincialSchool rdf:type owl:Class ;
                  rdfs:subClassOf :GovernmentSchool .

:PrivateSchool rdf:type owl:Class ;
               rdfs:subClassOf :School .

:EducationalStage rdf:type owl:Class .

:PrimaryStage rdf:type owl:Class ;
              rdfs:subClassOf :EducationalStage .

:JuniorSecondaryStage rdf:type owl:Class ;
                     rdfs:subClassOf :EducationalStage .

:SeniorSecondaryStage rdf:type owl:Class ;
                     rdfs:subClassOf :EducationalStage .

:CollegiateStage rdf:type owl:Class ;
                 rdfs:subClassOf :EducationalStage ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :preparesForExam ;
                                   owl:hasValue :AL_Exam
                                 ] .

:Subject rdf:type owl:Class .

:CoreSubject rdf:type owl:Class ;
             rdfs:subClassOf :Subject .

:AL_StreamSubject rdf:type owl:Class ;
                  rdfs:subClassOf :Subject .

:Examination rdf:type owl:Class .

:Grade5Scholarship rdf:type owl:Class ;
                   rdfs:subClassOf :Examination .

:OL_Exam rdf:type owl:Class ;
         rdfs:subClassOf :Examination .

:AL_Exam rdf:type owl:Class ;
         rdfs:subClassOf :Examination .

# Defined / Equivalent Classes

:AL_Student rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:intersectionOf ( :Student
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :enrolledInStage ;
                                                         owl:someValuesFrom :CollegiateStage
                                                       ]
                                                     )
                                ] .

:STEM_Teacher rdf:type owl:Class ;
              owl:equivalentClass [ rdf:type owl:Class ;
                                    owl:intersectionOf ( :Teacher
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :teachesSubject ;
                                                           owl:someValuesFrom [ rdf:type owl:Class ;
                                                                                owl:unionOf ( :Physics
                                                                                              :CombinedMathematics
                                                                                              :Chemistry
                                                                                            )
                                                                              ]
                                                         ]
                                                       )
                                  ] .

:NationalSchoolStudent rdf:type owl:Class ;
                       owl:equivalentClass [ rdf:type owl:Class ;
                                             owl:intersectionOf ( :Student
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty :attendsSchool ;
                                                                    owl:someValuesFrom :NationalSchool
                                                                  ]
                                                                )
                                           ] .

# Specific Subject Subclasses for Axioms

:Physics rdf:type owl:Class ; rdfs:subClassOf :AL_StreamSubject .
:CombinedMathematics rdf:type owl:Class ; rdfs:subClassOf :AL_StreamSubject .
:Chemistry rdf:type owl:Class ; rdfs:subClassOf :AL_StreamSubject .

#################################################################
#    Axioms / Constraints
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Student :Teacher :Principal )
] .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :GovernmentSchool :PrivateSchool )
] .

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :PrimaryStage :JuniorSecondaryStage :SeniorSecondaryStage :CollegiateStage )
] .

#################################################################
#    Individuals (30+)
#################################################################

# Schools
:RoyalCollege_Colombo rdf:type owl:NamedIndividual , :NationalSchool ;
                      :hasCensusNo "WP1001" .
:VisakhaVidyalaya_Colombo rdf:type owl:NamedIndividual , :NationalSchool ;
                          :hasCensusNo "WP1002" .
:TaxilaCentral_Horana rdf:type owl:NamedIndividual , :NationalSchool ;
                       :hasCensusNo "WP1003" .
:BandaranayakeCollege_Gampaha rdf:type owl:NamedIndividual , :NationalSchool ;
                               :hasCensusNo "WP1004" .
:RathnavaliBalika_Gampaha rdf:type owl:NamedIndividual , :NationalSchool ;
                           :hasCensusNo "WP1005" .
:KirindiwelaMahaVidyalaya rdf:type owl:NamedIndividual , :ProvincialSchool ;
                          :hasCensusNo "WP2001" .
:SThomasCollege_MountLavinia rdf:type owl:NamedIndividual , :PrivateSchool ;
                              :hasCensusNo "PV3001" .

# Educational Stages
:Stage_Primary rdf:type owl:NamedIndividual , :PrimaryStage .
:Stage_JuniorSec rdf:type owl:NamedIndividual , :JuniorSecondaryStage .
:Stage_SeniorSec rdf:type owl:NamedIndividual , :SeniorSecondaryStage .
:Stage_Collegiate rdf:type owl:NamedIndividual , :CollegiateStage .

# Examinations
:Grade5_Exam_2026 rdf:type owl:NamedIndividual , :Grade5Scholarship ;
                  :hasExamYear 2026 .
:OL_Exam_2026 rdf:type owl:NamedIndividual , :OL_Exam ;
              :hasExamYear 2026 .
:AL_Exam rdf:type owl:NamedIndividual , :AL_Exam ;
         :hasExamYear 2026 .

# Subjects
:SinhalaLanguage rdf:type owl:NamedIndividual , :CoreSubject ; :hasSubjectCode "SUB101" .
:Mathematics_Core rdf:type owl:NamedIndividual , :CoreSubject ; :hasSubjectCode "SUB102" .
:Science_Core rdf:type owl:NamedIndividual , :CoreSubject ; :hasSubjectCode "SUB103" .
:EnglishLanguage rdf:type owl:NamedIndividual , :CoreSubject ; :hasSubjectCode "SUB104" .
:Subject_Physics rdf:type owl:NamedIndividual , :Physics ; :hasSubjectCode "AL201" .
:Subject_CombinedMaths rdf:type owl:NamedIndividual , :CombinedMathematics ; :hasSubjectCode "AL202" .
:Subject_Chemistry rdf:type owl:NamedIndividual , :Chemistry ; :hasSubjectCode "AL203" .

# Teachers
:Mr_Perera rdf:type owl:NamedIndividual , :Teacher ;
           :hasTeacherID "T1001" ;
           :teachesSubject :Subject_CombinedMaths .
:Mrs_Silva rdf:type owl:NamedIndividual , :Teacher ;
           :hasTeacherID "T1002" ;
           :teachesSubject :Subject_Physics .
:Mr_Fernando rdf:type owl:NamedIndividual , :Teacher ;
             :hasTeacherID "T1003" ;
             :teachesSubject :SinhalaLanguage .

